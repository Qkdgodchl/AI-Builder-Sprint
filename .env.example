# PostgreSQL Docker local development settings (docker-compose.yml)
POSTGRES_DB=pixelcare
POSTGRES_USER=pixelcare
POSTGRES_PASSWORD=pixelcare_local
POSTGRES_PORT=5432

# Spring Boot datasource settings
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/pixelcare
SPRING_DATASOURCE_USERNAME=pixelcare
SPRING_DATASOURCE_PASSWORD=pixelcare_local

# External API: put the real key only in your local .env or shell environment.
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro3

# Frontend build/runtime API origin (Vite)
VITE_API_BASE_URL=http://localhost:8080

# Modusign template-based SECURE_LINK integration
# The participant role must exactly match the role configured in the Modusign template.
MODUSIGN_USER_EMAIL=
MODUSIGN_API_KEY=
MODUSIGN_BASE_URL=https://api.modusign.co.kr
MODUSIGN_TEMPLATE_ID=
MODUSIGN_PARTICIPANT_ROLE=신청자
MODUSIGN_REDIRECT_URL=http://127.0.0.1:5173/my-page
# Configure this value as the X-Pixelcare-Webhook-Secret custom header in Modusign.
MODUSIGN_WEBHOOK_SECRET=
# Backup account used when the primary account hits the free-plan signature limit (~30 docs).
# Leave blank to fall back to simulation mode instead.
MODUSIGN_BACKUP_USER_EMAIL=
MODUSIGN_BACKUP_API_KEY=

# Local demo accounts. Change these outside local development.
APP_BOOTSTRAP_ENABLED=true
APP_OPERATOR_PASSWORD=Operator123!
APP_MANAGER_PASSWORD=Manager123!
APP_DONOR_PASSWORD=Donor123!
